# Audio
CONFIG_SND_SOC_TFA98XX=y

# Boot
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y
CONFIG_DEFAULT_MMAP_MIN_ADDR=32768
CONFIG_JUMP_LABEL=y

# Display
CONFIG_LCD_CLASS_DEVICE=n

# DSP
CONFIG_MSM_AVTIMER=y
CONFIG_MSM_CDC_PINCTRL=y

# DT
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# FIH
CONFIG_FIH=y
CONFIG_FIH_RC2=y
CONFIG_FIH_APR=y
CONFIG_FIH_INFO=y
CONFIG_FIH_GPIO=y
CONFIG_FIH_DDR=y
CONFIG_FIH_MFD=y
CONFIG_FIH_NV=y
CONFIG_FIH_SUT=y
CONFIG_FIH_FVER=y
CONFIG_FIH_UFS=y
CONFIG_FIH_TOUCH=y
CONFIG_FIH_LOG=y
CONFIG_FIH_SAMP=y
CONFIG_FIH_SENSOR=y
CONFIG_FIH_HAC=y
CONFIG_FIH_CPU=y
CONFIG_FIH_GYRO=y
CONFIG_FIH_ALSP=y
CONFIG_FIH_BATTERY=y

# FS
CONFIG_DM_DEFAULT_KEY=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_MSDOS_FS=n

# Fingerprint
CONFIG_CRYPTO_DRBG_HASH=y
CONFIG_CRYPTO_DRBG_CTR=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_INPUT_FPC1020=y
CONFIG_MSM_QBT1000=n

# IO
CONFIG_BLK_CGROUP=y
CONFIG_CAN=n
CONFIG_USB_SERIAL=n
CONFIG_USB_TUSB544=y

# Inline kernel modules
CONFIG_BRIDGE_NETFILTER=y
CONFIG_DVB_MPQ=y
CONFIG_DVB_MPQ_DEMUX=y
CONFIG_TSPP=y

# Led
CONFIG_LEDS_LM3644=y
CONFIG_LEDS_LP5523=y

# Memory
CONFIG_ANDROID_LOW_MEMORY_KILLER=n
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_PSI=y
CONFIG_ZRAM_WRITEBACK=y

# Net
CONFIG_ETHERNET=n
CONFIG_NET_ACT_CONNMARK=y

# Power
CONFIG_SMB1390_CHARGE_PUMP=n
CONFIG_QPNP_QNOVO=n
CONFIG_WIRELESS_CHARGER_P9221=y

# PSTORE
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Touchscreen
CONFIG_TOUCHSCREEN_SYNAPTICS_3708_CORE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_3708_RMI_DEV=y
CONFIG_TOUCHSCREEN_SYNAPTICS_3708_FW_UPDATE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_3708_TEST_REPORTING=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=n
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_v26=n

# WLAN
CONFIG_MSM_11AD=n
CONFIG_QCA_CLD_WLAN=y
CONFIG_WIL6210=n

# Others
CONFIG_COMPAT_VDSO=y
CONFIG_ESOC=n
CONFIG_HZ_300=y
CONFIG_LOGO=n
CONFIG_VT=n

# Debug
CONFIG_CORESIGHT=n
CONFIG_DM_DEBUG=n
CONFIG_DRM_SDE_EVTLOG_DEBUG=n
CONFIG_IOMMU_DEBUG=n
CONFIG_IOMMU_DEBUG_TRACKING=n
CONFIG_IOMMU_TESTS=n
CONFIG_MMC_TEST=n
CONFIG_MSM_RDBG=n
CONFIG_MSM_SDE_ROTATOR_EVTLOG_DEBUG=n
CONFIG_QCOM_LLCC_PERFMON=n
CONFIG_RMNET_DATA_DEBUG_PKT=n
CONFIG_SPMI_MSM_PMIC_ARB_DEBUG=n
CONFIG_VIDEO_ADV_DEBUG=n
